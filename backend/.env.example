# ============================================================
# OpenAI Configuration
# ============================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================
# Google OAuth2 Configuration
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Gmail API, Google Calendar API, Google Tasks API
# 4. Create OAuth2 credentials (Web application recommended for SSO)
#
# Two modes:
# - DEVELOPER_MODE=true  → use refresh token from env (OAuth Playground)
# - DEVELOPER_MODE=false → users login via /api/auth/google/start and tokens are stored locally (SQLite file)
# ============================================================
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret

# When DEVELOPER_MODE=true only:
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_USER_EMAIL=your-email@gmail.com

# Multi-user SSO mode settings:
DEVELOPER_MODE=false
FRONTEND_URL=http://localhost:5173
# Optional override (otherwise built from request host):
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Local DB file (sql.js)
DB_PATH=./data/app.sqlite

# Encryption key for storing refresh tokens.
# Provide a strong secret. Recommended: 32-byte base64.
TOKEN_ENCRYPTION_KEY=replace-with-strong-secret

# ============================================================
# Server Configuration
# ============================================================
PORT=3001
